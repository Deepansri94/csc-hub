{
  "name": "csc-hub",
  "private": true,
  "version": "0.0.0",
  "description": "CSC-HUB Application",
  "author": {
    "name": "Deepan",
    "email": "deepanindhi@gmail.com"
  },
  "homepage": "https://github.com/Deepansri94/csc-hub",
  "type": "module",
  "main": "main.js",
  "maintainer": "Deepan <deepanindhi@gmail.com>",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --import tsx/esm server.ts",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite --port=3000\" \"electron .\"",
    "electron:build": "vite build && electron-builder",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/run_test.ts"
  },
  "build": {
    "appId": "com.csc.hub",
    "productName": "CSC-HUB",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "public/pwa-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CSC-HUB",
      "artifactName": "${productName}-Setup.${ext}"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pino": "^10.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
